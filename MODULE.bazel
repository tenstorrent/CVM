module(name = "cvm", version = "")

# BCR dependencies
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "rules_python", version = "0.40.0")
bazel_dep(name = "gflags", version = "2.2.2", repo_name = "com_github_gflags_gflags")
bazel_dep(name = "platforms", version = "1.0.0")

# fmt from BCR
bazel_dep(name = "fmt", version = "9.1.0")

# Upstream Verilator + verilog_library rules
bazel_dep(name = "rules_verilator", version = "1.1.0")
bazel_dep(name = "rules_verilog", version = "1.1.0")
# rules_verilator 1.1.0 pulls verilator 5.046.bcr.3, whose build scripts use
# rules_venv with Python 3.10+ syntax (PEP 604 unions in venv_process_wrapper.py).
# cvm's Python toolchain is pinned to 3.9 to match deps/requirements_lock.txt,
# so override to the unpatched 5.046 release (still has the :timing target
# rules_verilator expects but doesn't use rules_venv).
single_version_override(
    module_name = "verilator",
    version = "5.046",
)

# Local compat shim that publishes the @rules_hdl//verilog:providers.bzl surface
# downstream Tenstorrent repos still load. Each verilog_library it defines emits
# both the legacy VerilogInfo and the upstream @rules_verilog VerilogInfo.
bazel_dep(name = "rules_hdl", version = "0.0.0")
local_path_override(
    module_name = "rules_hdl",
    path = "bazel/rules_hdl_compat",
)

# Python toolchain - use Python 3.9 to match requirements_lock.txt
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.9",
)

# Python pip extension for requirements
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "cvm_pypi",
    python_version = "3.9",
    requirements_lock = "//deps:requirements_lock.txt",
)
use_repo(pip, "cvm_pypi")
