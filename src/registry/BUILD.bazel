load("@rules_hdl//verilog:providers.bzl", "verilog_library")

cc_library(
  name = "registry",
  hdrs = ["registry.hpp"],
  srcs = ["registry_dpi.cpp"],
  deps = [
      "@cvm//:messenger",
      "//src/callbacks:callbacks",
      "@cvm//:topology",
  ],
  strip_include_prefix = "//src/registry",
  include_prefix = "cvm",
  alwayslink = True,
  linkstatic = True,
  visibility = ["//visibility:public"],
)

verilog_library(
    name = "registry_sv",
    srcs = [
        # Runs the queue from the design's clock; its DPI is in registry_dpi.
        "cvm_callbacks.sv",
        "registry.sv",
    ],
    deps = ["@cvm//:plusargs_sv"],
    visibility = ["//:__pkg__"],
)
