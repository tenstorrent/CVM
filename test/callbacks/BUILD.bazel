load("@rules_hdl//verilog:providers.bzl", "verilog_library")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")

cc_test(
    name = "callbacks_test",
    size = "small",
    srcs = ["callbacks_test.cpp"],
    deps = [
        "//src/callbacks:callbacks",
        "//third_party/vpi:vpi",
        "@com_google_googletest//:gtest_main",
        "@rules_verilator//verilator:verilated_runtime",
    ],
)

verilog_library(
    name = "callbacks_sv_test_sv",
    srcs = ["top.sv"],
    deps = ["//:registry_sv"],
    top_module = "top",
)

verilator_cc_library(
    name = "callbacks_sv_test_veri_lib",
    module = ":callbacks_sv_test_sv",
    vopts = ["--assert"],
)

cc_binary(
    name = "callbacks_sv_test",
    srcs = ["callbacks_sv_test.cpp"],
    deps = [
        "//src/callbacks:callbacks",
        "//:registry",
        "//third_party/vpi:vpi",
        ":callbacks_sv_test_veri_lib",
        "@com_google_googletest//:gtest_main",
    ],
)

sh_test(
    name = "sh_callbacks_sv_test",
    srcs = ["sim.sh"],
    args = ["$(location :callbacks_sv_test)"],
    data = [":callbacks_sv_test"],
)
