load("@rules_hdl//verilog:providers.bzl", "verilog_library")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("//:defs.bzl", "topology_gen")

topology_gen(
    name = "topology",
    srcs = ["topology.yml"],
    cc_attrs = {
        "alwayslink": True,
        "linkstatic": True,
    },
)

verilog_library(
    name = "top_sv",
    srcs = ["top.sv"],
    top_module = "top",
)

verilator_cc_library(
    name = "top_veri_lib",
    module = ":top_sv",
    vopts = [
        "--assert",
        "-Wno-DECLFILENAME",
        "+define+TB_EXTERNAL_CLOCK",
    ],
)

cc_binary(
    name = "registry_test",
    srcs = ["sim_main.cpp", "dummy.cpp", "dummy2.cpp", "dummy3.cpp", "dummy_static.cpp"],
    deps = [
        "@cvm//:topology",
        # Covers both dependency spellings in one binary: the bare topology
        # target and the :topology_registry compatibility alias.
        "@cvm//:registry",
        ":topology",
        ":topology_registry",
        "@com_google_googletest//:gtest_main",
        "top_veri_lib",
    ],
)

sh_test(
    name = "sh_registry_test",
    srcs = ["sim.sh"],
    args = ["$(location :registry_test)"],
    data = [":registry_test"],
)
