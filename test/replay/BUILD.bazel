load("@cvm_pypi//:requirements.bzl", "requirement")
load("@cvm//:defs.bzl", "replay", "replay_ports")
load("@rules_hdl//verilog:providers.bzl", "verilog_library")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("//:defs.bzl", "topology_gen")

topology_gen(
    name = "topology",
    srcs = ["topology.yml"],
    cc_attrs = {
        "alwayslink": True,
        "linkstatic": True,
    },
)

cc_test(
    name = "replay_test",
    size = "small",
    srcs = ["replay_test.cpp"],
    deps = [
        # The recording layers only: the component links the registry and the
        # transport, which this never exercises.
        "//src/replay:encoder",
        "//src/replay:source",
        "//third_party/vpi:vpi",
        "@com_google_googletest//:gtest_main",
    ],
)

verilog_library(
    name = "alu_pkg_sv",
    srcs = ["alu_pkg.sv"],
)

verilog_library(
    name = "alu_sv",
    srcs = ["dut.sv"],
    deps = [":alu_pkg_sv"],
    top_module = "alu",
)

# The spec comes from the DUT's own Verilog, so it cannot go stale: every
# scenario below replays ports slang read out of dut.sv.
replay(
    name = "alu_replay",
    clock = "clk",
    dut = "alu",
    dut_lib = ":alu_sv",
)

# The same DUT read with the define set. Only the spec is used -- it must be
# byte-identical to the one above, which is what proves the conditional ports
# are recovered rather than elaborated.
replay_ports(
    name = "alu_replay_defined_ports",
    clock = "clk",
    dut = "alu",
    dut_lib = ":alu_sv",
    slang_defines = ["FEAT_GATE"],
    # The same key, because the key is the only thing about the spec that comes
    # from the target rather than from the DUT.
    spec_name = "alu_replay",
)

# replay()'s other mode: a spec kept by hand. Nothing instantiates the module,
# but the testbench build elaborates it, so `width:` and `imports:` stay
# compiled.
replay(
    name = "alu_hand",
    srcs = ["alu_ports.yml"],
    # The spec names types from this package, so it has to elaborate first.
    deps = [":alu_pkg_sv"],
)

verilog_library(
    name = "tb_top_sv",
    srcs = ["tb_top.sv"],
    deps = [
        ":topology_sv",
        ":alu_pkg_sv",
        ":alu_hand_sv",
        ":alu_replay_sv",
        ":alu_sv",
        "//:plusargs_sv",
        "//:registry_sv",
        "//test/lib/sim:sim_sv",
    ],
    top_module = "top",
)

# Two builds of one testbench and one generated interposer, differing only in
# the define. FEAT_GATE adds a port pair to the DUT, so this is what holds the
# interposer to adapting the way the DUT does rather than being correct for the
# setting it happened to be generated under. Defines reach both from here:
# verilation is a single flat invocation over the whole closure.
verilator_cc_library(
    name = "tb_top_veri_lib",
    module = ":tb_top_sv",
    timing = True,
    vopts = ["--assert"],
)

verilator_cc_library(
    name = "tb_top_gate_veri_lib",
    module = ":tb_top_sv",
    timing = True,
    vopts = [
        "--assert",
        "+define+FEAT_GATE",
    ],
)

# Declares the scenario expectations so gflags validates them.
cc_library(
    name = "tb_flags",
    srcs = ["tb_flags.cpp"],
    alwayslink = True,
    linkstatic = True,
    deps = ["@com_github_gflags_gflags//:gflags"],
)

SIM_DEPS = [
    ":tb_flags",
    "//:logger",
    "//:plusargs",
    "//:registry",
    "//:topology",
    ":topology_cc",
    "//:replay",
    "//test/lib/sim:sim_dpi",
]

cc_binary(
    name = "sim",
    # main() only; the checks are in tb_top.sv so they travel to other
    # simulators.
    srcs = ["//test/lib/sim:sim_main"],
    deps = SIM_DEPS + [":tb_top_veri_lib"],
)

cc_binary(
    name = "sim_gate",
    srcs = ["//test/lib/sim:sim_main"],
    deps = SIM_DEPS + [":tb_top_gate_veri_lib"],
)

# One build, driven entirely by plusargs: replay, a second dump, bypass, and a
# corrupted dump that must fail.
[
    sh_test(
        name = "sh_" + scenario["name"],
        srcs = ["//test/lib/sim:sim.sh"],
        args = ["$(location :%s)" % scenario.get("sim", "sim")] + scenario["args"],
        data = [
            ":" + scenario.get("sim", "sim"),
            "//test/replay/fixtures:evcds",
        ],
    )
    for scenario in [
        # Runs to cycle 4, recorded result 7. Afterwards the testbench drives
        # 1 + 2, so a last result of 3 shows the inputs were handed back.
        {
            "name": "replay",
            "args": [
                "+cvm_replay_file=test/replay/fixtures/alu.evcd",
                "+expect_errors=0",
                "+expect_replay_result=7",
                "+expect_last_result=3",
                "+expect_done_cycles=7",
            ],
        },
        # Shorter, so the run length demonstrably comes from the recording.
        {
            "name": "replay_second_dump",
            "args": [
                "+cvm_replay_file=test/replay/fixtures/alu2.evcd",
                "+expect_errors=0",
                "+expect_replay_result=7",
                "+expect_last_result=3",
                "+expect_done_cycles=5",
            ],
        },
        # Same recording, selected by key rather than as a bare path.
        {
            "name": "replay_keyed_dump",
            "args": [
                "+cvm_replay_file=TOP.REPLAY=test/replay/fixtures/alu2.evcd",
                "+expect_errors=0",
                "+expect_replay_result=7",
                "+expect_last_result=3",
                "+expect_done_cycles=5",
            ],
        },
        # A recording loaded and never replayed: the testbench itself passes,
        # so the host's end-of-run check is the only thing that catches it.
        {
            "name": "never_enabled",
            "args": [
                "--expect-failure",
                "+cvm_replay_file=test/replay/fixtures/alu.evcd",
                "+skip_enable=1",
                "+expect_errors=0",
            ],
        },
        # No recording, so a transparent wire that finishes immediately -- but
        # the monitor must still see traffic.
        {
            "name": "no_recording",
            "args": [
                "+expect_errors=0",
                "+expect_last_result=3",
                "+expect_done_cycles=1",
            ],
        },
        # Both workers on, against the corrupted dump: the testbench reads the
        # host's error count straight after the summary call, so this is what
        # holds that call to completing before it returns.
        {
            "name": "replay_async_report",
            "args": [
                "+signal_async=1",
                "+cb_async=1",
                "+cvm_replay_file=test/replay/fixtures/alu_bad.evcd",
                "+expect_errors=1",
                "+expect_replay_result=7",
                "+expect_done_cycles=7",
            ],
        },
        # Load bearing: the only scenario that fails if the checker stops
        # running. One recorded result bit is wrong, so exactly one summary
        # must appear; the stimulus is untouched.
        {
            "name": "replay_mismatch_detected",
            "args": [
                "+cvm_replay_file=test/replay/fixtures/alu_bad.evcd",
                "+expect_errors=1",
                "+expect_replay_result=7",
                "+expect_last_result=3",
                "+expect_done_cycles=7",
            ],
        },
        # A recording of the FEAT_GATE build replayed against the build
        # without it. The two ports it carries have no binding, which is
        # indistinguishable from a spec that has drifted from its DUT -- so the
        # run must die rather than quietly replay the other eleven.
        {
            "name": "replay_define_mismatch",
            "args": [
                "--expect-failure",
                "--expect-message=which the interposer does not replay",
                "+cvm_replay_file=test/replay/fixtures/alu_gate.evcd",
                "+expect_errors=0",
            ],
        },
        # The other side of the conditional: two more ports in the DUT, the
        # interposer and the recording. Every scenario above is the same
        # interposer with the define off, which is what makes this pair
        # evidence and not just one more configuration that happens to work.
        {
            "name": "replay_gate",
            "sim": "sim_gate",
            "args": [
                "+cvm_replay_file=test/replay/fixtures/alu_gate.evcd",
                "+expect_errors=0",
                "+expect_replay_result=7",
                "+expect_last_result=3",
                "+expect_done_cycles=7",
            ],
        },
    ]
]

test_suite(
    name = "smoke",
    tests = [
        "replay_test",
        ":sh_never_enabled",
        ":sh_no_recording",
        ":sh_replay",
        ":sh_replay_async_report",
        ":sh_replay_keyed_dump",
        ":sh_replay_mismatch_detected",
        ":sh_replay_define_mismatch",
        ":sh_replay_gate",
        ":sh_replay_second_dump",
        ":sh_spec_is_define_independent",
        ":sh_spec_matches_golden",
    ],
)

# The producer's invariant. slang has to pick a branch to elaborate, so the
# only way the spec can describe the module rather than the build is if the
# defines make no difference to it. If these differ, a port in the untaken
# branch was elaborated instead of recovered -- or dropped.
sh_test(
    name = "sh_spec_is_define_independent",
    size = "small",
    srcs = ["spec_diff.sh"],
    args = [
        "$(location :alu_replay_ports.yml)",
        "$(location :alu_replay_defined_ports.yml)",
        "the spec depends on FEAT_GATE, so it describes one build of alu rather than alu",
    ],
    data = [
        ":alu_replay_defined_ports.yml",
        ":alu_replay_ports.yml",
    ],
)

# So a change in what slang reports shows up in review rather than as a
# downstream elaboration error.
sh_test(
    name = "sh_spec_matches_golden",
    size = "small",
    srcs = ["spec_diff.sh"],
    args = [
        "$(location alu_ports_golden.yml)",
        "$(location :alu_replay_ports.yml)",
        "regenerate with: bazel build //test/replay:alu_replay_ports && cp bazel-bin/test/replay/alu_replay_ports.yml test/replay/alu_ports_golden.yml",
    ],
    data = [
        "alu_ports_golden.yml",
        ":alu_replay_ports.yml",
    ],
)

# Guards the two slang capabilities the port-spec producer depends on, under the
# interpreter bazel resolves rather than whatever is installed system-wide.
py_test(
    name = "pyslang_test",
    size = "small",
    srcs = ["pyslang_test.py"],
    deps = [requirement("pyslang")],
)
