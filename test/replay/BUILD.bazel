load("@cvm_pypi//:requirements.bzl", "requirement")

# What every replay scenario shares. The scenarios themselves are one directory
# each: alu/ is the DUT they replay, standalone/ puts the interposer in a
# testbench, buried/ puts it inside a design, engine/ drives the engine with no
# recording at all, spec/ is the port spec's own contract, and fixtures/ holds
# the recordings.

cc_test(
    name = "replay_test",
    size = "small",
    srcs = ["replay_test.cpp"],
    deps = [
        # The recording layers only: the component links the registry and the
        # transport, which this never exercises.
        "//src/replay:encoder",
        "//src/replay:source",
        "//third_party/vpi:vpi",
        "@com_google_googletest//:gtest_main",
    ],
)

# Guards the two slang capabilities the port-spec producer depends on, under the
# interpreter bazel resolves rather than whatever is installed system-wide.
py_test(
    name = "pyslang_test",
    size = "small",
    srcs = ["pyslang_test.py"],
    deps = [requirement("pyslang")],
)

# Declares the scenario expectations so gflags validates them. Shared, because
# standalone/ and buried/ check the same things.
cc_library(
    name = "tb_flags",
    srcs = ["tb_flags.cpp"],
    alwayslink = True,
    linkstatic = True,
    visibility = ["//test/replay:__subpackages__"],
    deps = ["@com_github_gflags_gflags//:gflags"],
)

test_suite(
    name = "smoke",
    tests = [
        ":replay_test",
        "//test/replay/buried:sh_buried",
        "//test/replay/buried:sh_passthrough",
        "//test/replay/spec:sh_define_independent",
        "//test/replay/spec:sh_matches_golden",
        "//test/replay/standalone:sh_never_enabled",
        "//test/replay/standalone:sh_no_recording",
        "//test/replay/standalone:sh_replay",
        "//test/replay/standalone:sh_replay_async_report",
        "//test/replay/standalone:sh_replay_gate",
        "//test/replay/standalone:sh_replay_keyed_dump",
        "//test/replay/standalone:sh_replay_mismatch_detected",
        "//test/replay/standalone:sh_replay_second_dump",
    ],
)
