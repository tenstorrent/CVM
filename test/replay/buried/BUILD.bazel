load("@cvm//:defs.bzl", "replay_force")
load("@rules_hdl//verilog:providers.bzl", "verilog_library")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("//:defs.bzl", "topology_gen")

# Replay of a DUT where it stands, inside a design that is not modified for it.
# One build: the harness is always present and does nothing until enabled, so
# there is no configuration to get wrong.

topology_gen(
    name = "topology",
    srcs = ["topology.yml"],
    cc_attrs = {
        "alwayslink": True,
        "linkstatic": True,
    },
)

# The spec comes from alu's own Verilog; the instance is named here because a
# hierarchical name cannot be a parameter.
replay_force(
    name = "alu_replay",
    clock = "clk",
    dut = "alu",
    dut_lib = "//test/replay/alu:alu_sv",
    instance_path = "top.u_core.u_alu",
)

verilog_library(
    name = "core_sv",
    srcs = ["core.sv"],
    deps = ["//test/replay/alu:alu_sv"],
)

verilog_library(
    name = "top_sv",
    srcs = ["top.sv"],
    top_module = "top",
    deps = [
        ":alu_replay_sv",
        ":core_sv",
        ":topology_sv",
        "//:plusargs_sv",
        "//:registry_sv",
        "//test/lib/sim:sim_sv",
    ],
)

verilator_cc_library(
    name = "top_veri_lib",
    module = ":top_sv",
    timing = True,
    vopts = ["--assert"],
)

cc_binary(
    name = "sim",
    srcs = ["//test/lib/sim:sim_main"],
    deps = [
        ":top_veri_lib",
        ":topology_cc",
        "//:logger",
        "//:plusargs",
        "//:registry",
        "//:replay",
        "//:topology",
        "//test/lib/sim:sim_dpi",
        "//test/replay:tb_flags",
    ],
)

[
    sh_test(
        name = "sh_" + scenario["name"],
        srcs = ["//test/lib/sim:sim.sh"],
        args = ["$(location :sim)"] + scenario["args"],
        data = [
            ":sim",
            "//test/replay/fixtures:evcds",
        ],
    )
    for scenario in [
        # The harness is elaborated but never enabled, so it forces nothing and
        # the design runs exactly as it would without it.
        {
            "name": "untouched",
            "args": [
                "+skip_enable=1",
                "+expect_errors=0",
                "+expect_last_result=3",
            ],
        },
        # The same build, replaying the buried instance.
        {
            "name": "buried",
            "args": [
                "+cvm_replay_file=test/replay/fixtures/alu.evcd",
                "+expect_errors=0",
                "+expect_replay_result=7",
                # The design drives 4 + 5 once replay lets go.
                "+expect_last_result=9",
                "+expect_done_cycles=7",
            ],
        },
        # Load bearing: one recorded output bit is wrong, so the checker must
        # report it.
        {
            "name": "buried_mismatch",
            "args": [
                "+cvm_replay_file=test/replay/fixtures/alu_bad.evcd",
                "+expect_errors=1",
                "+expect_replay_result=7",
                "+expect_done_cycles=7",
            ],
        },
    ]
]
