load("@cvm//:defs.bzl", "replay_ports")
load("@rules_hdl//verilog:providers.bzl", "verilog_library")

replay_ports(
    name = "alu_spec",
    clock = "clk",
    dut = "alu",
    dut_lib = "//test/replay/alu:alu_sv",
    spec_name = "alu_replay",
)

replay_ports(
    name = "alu_spec_defined",
    clock = "clk",
    dut = "alu",
    dut_lib = "//test/replay/alu:alu_sv",
    # Generate from same SV, but with different default preprocessor define path
    # The outputs must match regardless
    slang_defines = ["FEAT_GATE"],
    spec_name = "alu_replay",
)

sh_test(
    name = "sh_define_independent",
    size = "small",
    srcs = ["diff.sh"],
    args = [
        "$(location :alu_spec.yml)",
        "$(location :alu_spec_defined.yml)",
        "the spec depends on FEAT_GATE, so it describes one build of alu rather than alu",
    ],
    data = [
        ":alu_spec.yml",
        ":alu_spec_defined.yml",
    ],
)

# Parameters are never resolved, so the spec is the same at ALU_LANES=3.
replay_ports(
    name = "alu_spec_lanes3",
    clock = "clk",
    dut = "alu",
    dut_lib = "//test/replay/alu:alu_sv",
    slang_defines = ["ALU_LANES=3"],
    spec_name = "alu_replay",
)

sh_test(
    name = "sh_spec_parameterization_independent",
    size = "small",
    srcs = ["diff.sh"],
    args = [
        "$(location :alu_spec.yml)",
        "$(location :alu_spec_lanes3.yml)",
        "the spec depends on ALU_LANES, so it describes one parameterization of alu rather than alu",
    ],
    data = [
        ":alu_spec.yml",
        ":alu_spec_lanes3.yml",
    ],
)

# Types are copied as written, so the spec needs no package closure.
replay_ports(
    name = "alu_spec_no_closure",
    clock = "clk",
    dut = "alu",
    dut_lib = "//test/replay/alu:alu_decl_sv",
    spec_name = "alu_replay",
)

sh_test(
    name = "sh_spec_needs_no_closure",
    size = "small",
    srcs = ["diff.sh"],
    args = [
        "$(location :alu_spec.yml)",
        "$(location :alu_spec_no_closure.yml)",
        "the spec changed when the DUT packages were withheld, so the producer is resolving something it should only be copying",
    ],
    data = [
        ":alu_spec.yml",
        ":alu_spec_no_closure.yml",
    ],
)

# The spec must come out the same whichever branch of an `elsif` chain slang
# elaborates. Three readings, one per branch.
verilog_library(
    name = "elsif_sv",
    srcs = ["elsif.sv"],
)

[
    replay_ports(
        name = "elsif_spec" + suffix,
        clock = "clk",
        dut = "elsif_ports",
        dut_lib = ":elsif_sv",
        slang_defines = defines,
        spec_name = "elsif_replay",
    )
    for suffix, defines in [
        ("", []),
        ("_x", ["MODE_X"]),
        ("_y", ["MODE_Y"]),
    ]
]

[
    sh_test(
        name = "sh_elsif_define_independent" + suffix,
        size = "small",
        srcs = ["diff.sh"],
        args = [
            "$(location :elsif_spec.yml)",
            "$(location :elsif_spec%s.yml)" % suffix,
            "the spec depends on which branch of the `elsif` chain was " +
            "elaborated, so it describes one build of elsif_ports rather " +
            "than elsif_ports",
        ],
        data = [
            ":elsif_spec.yml",
            ":elsif_spec%s.yml" % suffix,
        ],
    )
    for suffix in ["_x", "_y"]
]

# Non-ANSI: multi-port conditional groups, null header ports, declaration order.
verilog_library(
    name = "nonansi_sv",
    srcs = ["nonansi.sv"],
)

[
    replay_ports(
        name = "nonansi_spec" + suffix,
        clock = "clk",
        dut = "nonansi_ports",
        dut_lib = ":nonansi_sv",
        slang_defines = defines,
        spec_name = "nonansi_replay",
    )
    for suffix, defines in [
        ("", []),
        ("_wide", ["FEAT_WIDE"]),
    ]
]

sh_test(
    name = "sh_nonansi_define_independent",
    size = "small",
    srcs = ["diff.sh"],
    args = [
        "$(location :nonansi_spec.yml)",
        "$(location :nonansi_spec_wide.yml)",
        "the spec depends on FEAT_WIDE. A branch of body declarations read as an ANSI port list yields only its first port, and a port ordered by its header name disagrees with a recovered one.",
    ],
    data = [
        ":nonansi_spec.yml",
        ":nonansi_spec_wide.yml",
    ],
)
